# Required for real Gemini calls
GEMINI_API_KEY=

# Current models selected from Google's August 2026 docs/cookbook
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Optional local settings
PORT=3000
DATA_DIR=./data
STALE_STEP_MS=300000

# Optional offline demo mode. Leave false for the real assessment run.
GEMINI_MOCK=false
